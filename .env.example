# Supabase (Project Settings -> API keys)
# The MT project is giicdspcpeunmosqmeio.
NEXT_PUBLIC_SUPABASE_URL=https://giicdspcpeunmosqmeio.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Service role key: server-side only, used by the AI pipeline and admin routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (all AI generation stages)
ANTHROPIC_API_KEY=sk-ant-...
# Model for the pipeline stages. The spec calls for claude-sonnet-4-6.
# claude-sonnet-5 is the newer model in the same tier and is a drop-in swap
# here: the pipeline sends no prefill, no sampling parameters and no thinking
# budget, so nothing else needs to change.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Stage 0 transcription. Supported: openai (Whisper). Leave unset to skip
# transcription (voice notes are stored and flagged for manual transcription).
TRANSCRIPTION_PROVIDER=
OPENAI_API_KEY=

# Base URL of the deployed app (used in auth email redirects and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Getting in without email ---------------------------------------------
# Supabase's built-in SMTP is rate limited to a few messages an hour and is not
# meant for production, so verification email is usually the first thing to
# fail. Two ways round it, in order of preference:
#
# 1. Turn off "Confirm email" in Supabase (Authentication -> Providers ->
#    Email), or create a pre-verified account:
#      node scripts/create-user.mjs you@mineraltechnologies.com 'password' marketing
#
# 2. Skip sign-in altogether. Works even on an empty database. This makes the
#    whole app public and fully privileged, with row-level security off:
#    every client name, unapproved number and internal quote. Only for a URL
#    nobody else has.
# AUTH_BYPASS=true
#    Optional: act as a specific existing account rather than the first
#    marketing user or a synthetic identity.
# AUTH_BYPASS_EMAIL=you@mineraltechnologies.com
